<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Madam Editor 😂</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #6a11cb, #2575fc, #ff6b6b);
    background-size: 300% 300%;
    animation: backgroundMove 10s ease infinite;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 25px 12px;
    overflow-x: hidden;
    color: white;
}

@keyframes backgroundMove {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}

.card {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 420px;
    padding: 30px 22px;
    text-align: center;
    border-radius: 28px;
    background: rgba(255,255,255,0.13);
    border: 1px solid rgba(255,255,255,0.4);
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    backdrop-filter: blur(15px);
    animation: entrance 1s ease;
}

@keyframes entrance {
    from {
        opacity: 0;
        transform: translateY(60px) scale(.8);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.badge {
    display: inline-block;
    background: #ffe600;
    color: #39205c;
    font-size: 12px;
    font-weight: bold;
    padding: 8px 14px;
    border-radius: 30px;
    margin-bottom: 20px;
}

.mainEmoji {
    font-size: 70px;
    display: block;
    animation: shake 1.5s infinite;
}

@keyframes shake {
    0%, 100% { transform: rotate(0) scale(1); }
    20% { transform: rotate(-12deg) scale(1.1); }
    40% { transform: rotate(12deg) scale(1.1); }
    60% { transform: rotate(-8deg); }
    80% { transform: rotate(8deg); }
}

h1 {
    font-size: 29px;
    margin: 15px 0 10px;
    line-height: 1.3;
}

h1 span {
    color: #ffe600;
}

.intro {
    line-height: 1.8;
    font-size: 15px;
    color: #f4f0ff;
    margin-bottom: 25px;
}

button {
    border: none;
    padding: 14px 20px;
    border-radius: 30px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    transition: .3s;
    margin: 5px;
    -webkit-tap-highlight-color: transparent;
}

button:active {
    transform: scale(.94);
}

.primary {
    background: #ffe600;
    color: #39205c;
    box-shadow: 0 6px 20px rgba(255,230,0,.25);
}

.primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(255,230,0,.4);
}

.letter {
    display: none;
    text-align: left;
    margin-top: 25px;
    padding: 20px;
    border-radius: 20px;
    background: #fff;
    color: #38304a;
    line-height: 1.85;
    font-size: 15px;
    animation: reveal .7s ease;
}

@keyframes reveal {
    from {
        opacity: 0;
        transform: translateY(25px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.letter h2 {
    text-align: center;
    color: #7b2ff7;
    margin-bottom: 17px;
}

.letter p {
    margin-bottom: 14px;
}

.highlight {
    color: #e83e8c;
    font-weight: bold;
}

.signature {
    text-align: right;
    color: #7b2ff7;
    font-weight: bold;
    margin-top: 20px;
}

.rating {
    display: none;
    margin-top: 22px;
    animation: reveal .5s ease;
}

.rating h3 {
    margin-bottom: 15px;
    line-height: 1.5;
}

.rating button {
    width: 100%;
    margin: 7px 0;
}

.good {
    background: #00e676;
    color: #153c2a;
}

.bad {
    background: #ff7676;
    color: #541313;
}

#result {
    display: none;
    margin-top: 18px;
    background: rgba(255,255,255,.18);
    border-radius: 15px;
    padding: 16px;
    line-height: 1.7;
    animation: reveal .5s ease;
}

.footer {
    margin-top: 24px;
    font-size: 12px;
    color: #eee4ff;
    line-height: 1.8;
}

/* Floating laughing emojis */
.floating {
    position: fixed;
    z-index: 1;
    bottom: -60px;
    pointer-events: none;
    animation: floatUp linear forwards;
}

@keyframes floatUp {
    0% {
        transform: translateY(0) rotate(0deg);
        opacity: 0;
    }
    10% { opacity: .9; }
    90% { opacity: .9; }
    100% {
        transform: translateY(-115vh) rotate(360deg);
        opacity: 0;
    }
}

/* Celebration */
.confetti {
    position: fixed;
    z-index: 10;
    top: -40px;
    pointer-events: none;
    animation: fall 3s linear forwards;
}

@keyframes fall {
    to {
        transform: translateY(110vh) rotate(720deg);
        opacity: 0;
    }
}

@media(max-width: 360px) {
    h1 { font-size: 25px; }
    .card { padding: 25px 16px; }
}
</style>
</head>

<body>

<div class="card">

    <div class="badge">🚨 OFFICIAL DEPARTMENTAL NOTICE 🚨</div>

    <span class="mainEmoji">😂</span>

    <h1>
        Hello, <span>Madam Editor!</span> 🤣
    </h1>

    <p class="intro">
        Edit and design, God u are great! 😭😂<br><br>
        Please, before you continue scrolling,
        kindly attend to this important announcement.
        Your attention is needed immediately! 🫡
    </p>

    <button class="primary" onclick="openLetter()">
        OPEN YOUR ANNOUNCEMENT 😂 👇
    </button>

    <div class="letter" id="letter">

        <h2>MISSION ACCOMPLISHED! 🫡🤣</h2>

        <p>
            Dear <strong>Madam Editor</strong>, 😂
        </p>

        <p>
            I visited your WhatsApp profile and saw
            <span class="highlight">"Edit and design, God u are great."</span>
        </p>

        <p>
            I said WAIT FIRST!!! 😭🤣
        </p>

        <p>
            So you're an editor, a designer AND a
            motivational speaker for Heaven? 🤣🤦‍♂️
        </p>

        <p>
            Your WhatsApp name alone contains a complete
            business plan and a Sunday sermon. 😂😂
        </p>

        <p>
            <span class="highlight">
                EDIT AND DESIGN! GOD U ARE GREAT! AMEN! 🤣🙏
            </span>
        </p>

        <p>
            Anyway, Madam CEO of Editing and Designing
            International Limited, I have officially done
            what you told me to do! 🎉😂
        </p>

        <p>
            Now, please rate my work out of 100.
            Choose wisely, because I have connections
            with the God in your WhatsApp name. 😭🤣
        </p>

        <p>
            If you give me 100, may your designs never
            lose quality and may your editing app never
            crash. 😂💻
        </p>

        <p>
            But if you give me zero...
            <strong>WE SHALL MEET IN THE DEPARTMENTAL COURT! 🤣⚖️</strong>
        </p>

        <div class="signature">
            Signed: Your Course Mate 😂<br>
            Department of Unnecessary Wahala 🤣
        </div>

    </div>

    <div class="rating" id="rating">

        <h3>SO, MADAM EDITOR... 🤣<br>
        HOW WOULD YOU RATE MY WORK?</h3>

        <button class="good" onclick="rateWork(100)">
            100/100 😂🔥
        </button>

        <button class="bad" onclick="rateWork(0)">
            0/100 😭🤣
        </button>

        <div id="result"></div>

    </div>

    <div class="footer">
        © 2026 Department of Unnecessary Wahala 🤣<br>
        No lecturer was disturbed during this operation. 😂
    </div>

</div>

<script>
const laughingEmojis = [
    "😂", "🤣", "😅", "😭", "🤦‍♂️", "💀", "🤡", "🫡"
];

// Continuously create floating laughing emojis.
function createFloatingEmoji() {
    const emoji = document.createElement("div");

    emoji.className = "floating";
    emoji.textContent =
        laughingEmojis[
            Math.floor(Math.random() * laughingEmojis.length)
        ];

    emoji.style.left = Math.random() * 100 + "vw";
    emoji.style.fontSize = (22 + Math.random() * 25) + "px";

    const duration = 5 + Math.random() * 5;
    emoji.style.animationDuration = duration + "s";

    document.body.appendChild(emoji);

    setTimeout(() => emoji.remove(), duration * 1000);
}

setInterval(createFloatingEmoji, 450);

// Open the letter.
function openLetter() {
    const letter = document.getElementById("letter");
    const rating = document.getElementById("rating");

    letter.style.display = "block";
    rating.style.display = "block";

    createCelebration();

    setTimeout(() => {
        letter.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    }, 150);
}

// Celebration animation.
function createCelebration() {
    for (let i = 0; i < 35; i++) {
        setTimeout(() => {
            const piece = document.createElement("div");

            piece.className = "confetti";

            const options = [
                "😂", "🤣", "🎉", "😅", "💀", "🤡", "🫡"
            ];

            piece.textContent =
                options[Math.floor(Math.random() * options.length)];

            piece.style.left = Math.random() * 100 + "vw";
            piece.style.fontSize = (20 + Math.random() * 20) + "px";

            document.body.appendChild(piece);

            setTimeout(() => piece.remove(), 3200);
        }, i * 60);
    }
}

// Funny rating responses.
function rateWork(score) {
    const result = document.getElementById("result");

    result.style.display = "block";

    if (score === 100) {
        result.innerHTML =
            "I KNEW YOU HAD GOOD TASTE! 😂🔥<br><br>" +
            "Madam Editor has approved the project! 🫡🤣<br>" +
            "Please, where is my award? 🏆😭";

        createCelebration();

    } else {
        result.innerHTML =
            "ZERO?! 😭😭🤣<br><br>" +
            "Wait first! Let me consult the God in your " +
            "WhatsApp name! 🙏😂<br><br>" +
            "APPEAL SUBMITTED! ⚖️🤣";

        createCelebration();
    }

    result.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
    });
}
</script>

</body>
</html>
